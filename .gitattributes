# 强制 LF 换行（Linux 上 systemd unit / bash 脚本 / Python 必须 LF，否则解析异常）
*.sh        text eol=lf
*.service   text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf

# 图片/二进制：明确标 binary，禁止任何换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.woff*     binary
