[Unit]
Description=闪联AI周刊 Web 服务
After=network.target

[Service]
Type=simple
# 用户与路径以实际部署为准（jinqi @ /home/jinqi/my-ai-weekly）
User=jinqi
WorkingDirectory=/home/jinqi/my-ai-weekly
Environment=PYTHONUNBUFFERED=1
# 密钥通过 .env 注入（ARK_API_KEY / ARK_BASE_URL / ARK_MODEL / SMTP 等）
EnvironmentFile=/home/jinqi/my-ai-weekly/.env
# 局域网可访问：直接 -b 0.0.0.0:5000；如需更安全可改 127.0.0.1:5000 + nginx 反代
ExecStart=/home/jinqi/my-ai-weekly/venv/bin/gunicorn -w 2 -b 0.0.0.0:5000 web_server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target